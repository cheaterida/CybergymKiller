# =====================================================================
# CybergymKiller 配置模板（可入库共享；不含任何真实凭据）
#
# 使用方式：
#   1. cp config.toml.example config.toml.local
#   2. 在 config.toml.local 中填入真实凭据（api_key / cybergym_api_key / 内网模型地址）
#   3. config.toml.local 已被 .gitignore 忽略，永不入库
#
# 加载优先级（config.py）：环境变量 > config.toml.local > config.toml > 默认值
#
# 说明：本项目主体由 opencode 驱动（模型经 opencode.json 的 provider 配置调用），
# 这里的 [agent] 配置主要被离线工具（knowledge/maintain.py 等）读取。
# 旧版本（multi-agent trial / research-agent）遗留的 token/压缩/builder 等配置
# 已移除，当前版本不使用。
# =====================================================================

[agent]
# 模型 API（LLM）配置 —— 仅内网可达（真实地址禁止提交到仓库）
model = "<MODEL_ID>"                   # 主模型 id
base_url = "<MODEL_API_BASE_URL>"      # 内网模型 API 端点（OpenAI 兼容 /v1）；
                                       # 真实地址只填到 config.toml.local，禁止提交
api_key = "sk-..."                     # 模型 API 密钥：向模型服务商控制台申请/创建

# CyberGym 提交服务器密钥：必须是 cybergym server 启动时使用的同一个 key。
# 服务器命令见 README（python3 -m cybergym.server ...）；若不一致，/submit-fix
# 会被服务器以 404 拒绝（服务器故意伪装 404），导致 fix 侧永远无法判定。
cybergym_api_key = "cybergym-..."

timeout = 1200                 # 模型请求超时（秒，离线工具用）

[paths]
# 任务数据路径（相对项目根）——由 config.py 解析为绝对路径
cybergym_home = "../cybergym"   # CyberGym 数据根（tasks/、cybergym-server-data/ 所在）
tasks_dir = "tasks"             # 任务目录（相对 cybergym_home），每任务一个 <family>_<id>/
logs_dir = "logs"               # 日志根（批次目录、archive、reflections 所在）

[tools]
# 外部格式知识库（vendored 在项目内）
format_kb_home = "vendor/format_kb"

[sandbox]
submit_timeout = 120    # submit.sh / /submit-fix 请求超时（秒）

[knowledge]
# 经验知识库目录（reasoning/format 两个域，见 AGENTS.md）
home = "knowledge"
